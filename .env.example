# xAI API key for Grok recommendations (never commit the real key)
XAI_API_KEY=

# Public site origin (no trailing slash). Used for Stripe success/cancel + portal return URLs.
# Local: http://localhost:5173   Production: https://your.domain
PUBLIC_BASE_URL=http://localhost:5173

# Signed httpOnly entitlement cookies (use a long random string in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: pin Price IDs. If omitted and STRIPE_SECRET_KEY is set, the API
# auto-creates product "Photo Recipes Pro" with $7.99/mo and $59.99/yr prices.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# App Store IAP (iOS Pro unlock — required in production on photo.grepawk.com)
# Create key: App Store Connect → Users and Access → Integrations → In-App Purchase
APPLE_IAP_BUNDLE_ID=com.ragnus.mvp
APPLE_IAP_PRODUCT_MONTHLY=com.ragnus.mvp.pro.monthly
APPLE_IAP_PRODUCT_YEARLY=com.ragnus.mvp.pro.yearly
# APPLE_IAP_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# APPLE_IAP_KEY_ID=ABCDEFGHIJ
# PEM contents; use literal \n for single-line EnvironmentFile values (never commit real key)
# APPLE_IAP_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Optional: Production (default) | Sandbox. On not-found, server auto-tries the other (TestFlight).
# APPLE_IAP_ENVIRONMENT=Production

# Resend (landing waitlist / email capture) — https://resend.com/api-keys
# Server-only. Never expose to the Vite client (no VITE_ prefix).
RESEND_API_KEY=
# Preferred: Contacts segment ID for "waitlist" or "field-notes".
# If omitted, the API looks up / creates a segment named waitlist.
RESEND_SEGMENT_ID=
# Legacy optional: Resend Audience ID (older Audiences API). Used only if no segment resolves.
RESEND_AUDIENCE_ID=
# Optional: From address for notify mail (must be a verified Resend domain/sender)
RESEND_FROM=Photo Recipes <onboarding@resend.dev>
# Optional: notify this inbox on each signup (in addition to segment/local store)
WAITLIST_NOTIFY_TO=

# ---------------------------------------------------------------------------
# Push Experiment 1 — pre-alarm shoot brief (iOS APNs)
# Feature flag OFF by default. Prefer cron → POST /api/push/tick over setInterval.
# ---------------------------------------------------------------------------
PUSH_EXP1_ENABLED=false
# Shared secret for X-Push-Cron-Secret on POST /api/push/tick and /api/push/test-send.
# BLAST CAPABILITY: possession can trigger APNs sends — rotate immediately if leaked.
# Production test-send also requires X-Push-Test-Allow-Production: 1.
PUSH_CRON_SECRET=
# APNs (.p8 never commit — path on server or contents via EnvironmentFile only)
# When KEY_ID + TEAM_ID + (.p8 path or contents) are set, server/apns.ts sends live
# HTTP/2 JWT notifications. Unset → fail-soft stub (safe for local/CI).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.ragnus.mvp
# Matches ios PRODUCT_BUNDLE_IDENTIFIER / project.yml (not com.yishengjiang.*)
# Absolute path to AuthKey_XXX.p8 on the Ubuntu host (preferred)
APNS_P8_PATH=
# Or PEM contents with literal \n (avoid if possible; never commit)
# APNS_P8_CONTENTS=
# sandbox (TestFlight/dev) | production (App Store). Default: sandbox.
# Per-device environment from register still wins when set on the token.
APNS_ENVIRONMENT=sandbox

# ---------------------------------------------------------------------------
# In-house funnel telemetry (MySQL). Soft no-op when unset — API still 202s.
# Production: /etc/photo-recipes.env (systemd EnvironmentFile)
# ---------------------------------------------------------------------------
# MYSQL_URL=mysql://user:pass@127.0.0.1:3306/photo_recipes
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
# Shared secret for GET /api/telemetry/funnels (header X-Telemetry-Read-Key)
TELEMETRY_READ_KEY=
# Optional salt for hashed client IPs (defaults to SESSION_SECRET)
# TELEMETRY_IP_SALT=

# ---------------------------------------------------------------------------
# Admin dashboard (/admin) — password gate for telemetry + income snapshot
# Production: /etc/photo-recipes.env (never commit real values)
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=
# Optional alternate: Authorization: Bearer <token> or X-Admin-Token
# ADMIN_TOKEN=

# ---------------------------------------------------------------------------
# Free Peek daily Ask / Photo Vision / Auto Optimize (server gate)
# Production: /etc/photo-recipes.env — change + systemctl restart photo-recipes
# ---------------------------------------------------------------------------
# Combined free-tier asks per UTC day (default 5 if unset)
FREE_DAILY_LIMIT=5
# Free users may apply camera dials / phoneTargets (default true). Prefer Admin panel override.
FREE_PHONE_TARGETS_ENABLED=true
# Comma-separated emails with unlimited Ask/Vision/assist (owner always included)
FREE_UNLIMITED_EMAILS=yisheng.jiang@gmail.com
# Optional: unsigned pr_guest UUIDs (or X-Device-Id) for TestFlight without login
# UNLIMITED_DEVICE_IDS=
# Optional: Authorization: Bearer <ADMIN_TOKEN> or X-Admin-Token also skips quota


# ---------------------------------------------------------------------------
# Recommend path — default is fast one-shot (no tools). Set to 1 for legacy.
# ---------------------------------------------------------------------------
# RECOMMEND_TOOL_LOOP=1
