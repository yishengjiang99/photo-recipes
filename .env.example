# xAI API key for Grok recommendations (never commit the real key)
XAI_API_KEY=

# Public site origin (no trailing slash). Used for Stripe success/cancel + portal return URLs.
# Local: http://localhost:5173   Production: https://your.domain
PUBLIC_BASE_URL=http://localhost:5173

# Signed httpOnly entitlement cookies (use a long random string in production)
SESSION_SECRET=change-me-to-a-long-random-string

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional: pin Price IDs. If omitted and STRIPE_SECRET_KEY is set, the API
# auto-creates product "Photo Recipes Pro" with $7.99/mo and $59.99/yr prices.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# App Store IAP (iOS Pro unlock — required in production)
# APPLE_IAP_BUNDLE_ID=com.ragnus.mvp
# APPLE_IAP_PRODUCT_MONTHLY=com.ragnus.mvp.pro.monthly
# APPLE_IAP_PRODUCT_YEARLY=com.ragnus.mvp.pro.yearly
# APPLE_IAP_ISSUER_ID=
# APPLE_IAP_KEY_ID=
# APPLE_IAP_PRIVATE_KEY=

# Resend (landing waitlist / email capture) — https://resend.com/api-keys
# Server-only. Never expose to the Vite client (no VITE_ prefix).
RESEND_API_KEY=
# Preferred: Contacts segment ID for "waitlist" or "field-notes".
# If omitted, the API looks up / creates a segment named waitlist.
RESEND_SEGMENT_ID=
# Legacy optional: Resend Audience ID (older Audiences API). Used only if no segment resolves.
RESEND_AUDIENCE_ID=
# Optional: From address for notify mail (must be a verified Resend domain/sender)
RESEND_FROM=Photo Recipes <onboarding@resend.dev>
# Optional: notify this inbox on each signup (in addition to segment/local store)
WAITLIST_NOTIFY_TO=

# ---------------------------------------------------------------------------
# Push Experiment 1 — pre-alarm shoot brief (iOS APNs)
# Feature flag OFF by default. Prefer cron → POST /api/push/tick over setInterval.
# ---------------------------------------------------------------------------
PUSH_EXP1_ENABLED=false
# Shared secret for X-Push-Cron-Secret header on POST /api/push/tick
PUSH_CRON_SECRET=
# APNs (.p8 never commit — path on server or contents via EnvironmentFile only)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=com.ragnus.mvp
# Absolute path to AuthKey_XXX.p8 on the Ubuntu host (preferred)
APNS_P8_PATH=
# Or PEM contents with literal \n (avoid if possible; never commit)
# APNS_P8_CONTENTS=
