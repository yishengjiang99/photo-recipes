# Photo Recipes — nginx site (templated by deploy.sh)
# DEPLOY_PATH and SERVER_NAME are substituted at deploy time.

server {
    listen 80;
    listen [::]:80;
    server_name SERVER_NAME_PLACEHOLDER;

    root DEPLOY_PATH_PLACEHOLDER/dist;
    index index.html;

    # Phone Auto Optimize / vision uploads: HEIC→JPEG frames can exceed nginx's
    # default 1m; keep in sync with Express json + MAX_IMAGE_BYTES (~100MB).
    client_max_body_size 100m;

    # Hashed Vite assets — long cache
    location /assets/ {
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # JS: force a Safari-friendly MIME (module scripts reject wrong types).
    # types map prefers text/javascript; default_type covers if types is empty.
    location ~* \.js$ {
        types { text/javascript js; }
        default_type application/javascript;
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    location ~* \.(css|png|jpg|jpeg|gif|svg|ico|webp|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # SPA HTML — never cache (prevents blank page after deploy when old
    # index.html points at deleted hashed JS)
    location / {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
        try_files $uri $uri/ /index.html;
    }
}
