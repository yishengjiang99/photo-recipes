# Photo Recipes — nginx site (templated by deploy.sh)
# DEPLOY_PATH and SERVER_NAME are substituted at deploy time.

server {
    listen 80;
    listen [::]:80;
    server_name SERVER_NAME_PLACEHOLDER;

    root DEPLOY_PATH_PLACEHOLDER/dist;
    index index.html;

    # Phone Auto Optimize / vision uploads: HEIC→JPEG frames can exceed nginx's
    # default 1m; keep in sync with Express json + MAX_IMAGE_BYTES (~100MB).
    client_max_body_size 100m;

    # Real 404s: unknown paths get dist/404.html with status 404 (SPA routes are listed below).
    error_page 404 /404.html;

    # Hashed Vite assets — long cache
    location ^~ /assets/ {
        # ^~ so the regex locations below do not take over hashed files; same Safari-friendly JS type.
        types {
            text/javascript js mjs;
            text/css css;
            image/png png;
            image/jpeg jpg jpeg;
            image/webp webp;
            image/svg+xml svg;
            font/woff2 woff2;
        }
        include DEPLOY_PATH_PLACEHOLDER/deploy/nginx-photo-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    # BEGIN photo-recipes apple-attribution-postbacks (managed by photo-recipes deploy.sh)
    # Apple sends SKAdNetwork / AdAttributionKit postback copies to the registrable
    # domain (grepawk.com), so these paths proxy to the Photo Recipes API on :8787.
    location ^~ /.well-known/skadnetwork/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 64k;
    }
    location ^~ /.well-known/appattribution/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 64k;
    }
    # END photo-recipes apple-attribution-postbacks

    location /api/ {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    # JS: force a Safari-friendly MIME (module scripts reject wrong types).
    # types map prefers text/javascript; default_type covers if types is empty.
    location ~* \.js$ {
        types { text/javascript js; }
        default_type application/javascript;
        include DEPLOY_PATH_PLACEHOLDER/deploy/nginx-photo-headers.conf;
        expires 7d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }

    # Unhashed public images/icons: one week (hashed /assets/ above get a year).
    location ~* \.(css|png|jpg|jpeg|gif|svg|ico|webp|woff2?)$ {
        include DEPLOY_PATH_PLACEHOLDER/deploy/nginx-photo-headers.conf;
        expires 7d;
        add_header Cache-Control "public, max-age=604800" always;
        try_files $uri =404;
    }

    # HTML — never cache (prevents blank page after deploy when old index.html points at deleted
    # hashed JS). Pre-rendered pages: / (index.html), /privacy, /terms, /support (*.html).
    location = / {
        include DEPLOY_PATH_PLACEHOLDER/deploy/nginx-photo-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
        try_files /index.html =404;
    }
    location ~ ^/(privacy|terms|support)/?$ {
        include DEPLOY_PATH_PLACEHOLDER/deploy/nginx-photo-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
        default_type text/html;
        try_files /$1.html /index.html;
    }
    # Client-side routes of the SPA (src/App.tsx): app shell, admin UI, checkout return, legacy paths.
    location ~ ^/(app(/.*)?|admin|success|preset/[^/]+)/?$ {
        include DEPLOY_PATH_PLACEHOLDER/deploy/nginx-photo-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Expires "0";
        try_files /index.html =404;
    }
    # Everything else: real files from dist/ (robots.txt, sitemap.xml, manifest, OG image), else 404.
    location / {
        include DEPLOY_PATH_PLACEHOLDER/deploy/nginx-photo-headers.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        try_files $uri =404;
    }
}
